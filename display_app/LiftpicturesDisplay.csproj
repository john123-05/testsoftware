<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Liftpictures Display: zeigt die lokalen Seiten des Agenten als eigenes
    Programm (ohne Browserleiste) - die Presentation auf dem zweiten Monitor
    und die Station auf dem Hauptmonitor. Im Kiosk-Modus laeuft hier das neue
    Verkaufsprogramm (Liftpictures Kiosk) samt Geraeten.

    32 Bit (x86): der Treiber des Muenzgeraets (NRI PaymentManager.dll) ist
    32 Bit und muss im selben Prozess laufen. WebView2 laeuft trotzdem als
    eigener 64-Bit-Prozess.

    .NET Framework 4.8 ist auf jedem Windows 10/11 vorhanden, die Anzeige
    uebernimmt die WebView2-Laufzeit (kommt mit Microsoft Edge). Damit braucht
    der PC nichts zusaetzlich installiert; das Programm ist nur wenige
    hundert KB gross. Gebaut wird es in .github/workflows/build-windows.yml.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <AssemblyName>LiftpicturesDisplay</AssemblyName>
    <RootNamespace>Liftpictures.Display</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <Company>Liftpictures</Company>
    <Product>Liftpictures Display</Product>
    <Description>Liftpictures Presentation, Station and Kiosk</Description>
    <Version>0.8.1</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Management" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Xml" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2210.55" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
